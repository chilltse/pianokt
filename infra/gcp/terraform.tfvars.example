project_id = "YOUR_PROJECT"
region = "us-central1"
image = "us-central1-docker.pkg.dev/YOUR_PROJECT/pianokt/backend:VERSION"
spark_image = "us-central1-docker.pkg.dev/YOUR_PROJECT/pianokt/pipeline:VERSION"
frontend_origin = "https://YOUR_FRONTEND"
supabase_url = "https://YOUR_SUPABASE.supabase.co"
supabase_anon_key = "PUBLIC_ANON_KEY"
database_secret_id = "pianokt-database-url"
schedules_paused = true

source_environment = "production"
lake_pipeline_paused = true
# Keep production origins free of localhost; use a separate development deployment.
local_development_origins = []

# First rollout: keep relay_schedule="* * * * *" until direct dispatch is verified.
# Final target: enable schedules, keep Lake paused, then compensate every 15 min.
relay_schedule = "*/15 * * * *"
direct_pubsub_enabled = false
direct_pubsub_timeout_s = 2
