# ==============================================================================
# 伪目标声明（.PHONY）
# 告诉 Make：后面列出的名称都是“动作指令”，而非真实存在的磁盘文件名。
# 作用：即使项目根目录下恰好有名为 'api' 或 'worker' 的同名文件或文件夹，
# 运行 `make api` 时 Make 依然会强制执行对应的命令，避免因“文件已存在且未更新”导致指令跳过。
# ==============================================================================
.PHONY: backend-test api worker relay pipeline

# ------------------------------------------------------------------------------
# 1. 运行后端单元与集成测试
# ------------------------------------------------------------------------------
# python -m pytest: 使用当前 Python 环境中的 pytest 模块运行测试
# backend/tests: 指定要扫描并执行测试代码的目录
# -q (--quiet): 静默模式，精简控制台输出，仅展示关键的测试进度和失败详情
backend-test:
	python -m pytest backend/tests -q

# ------------------------------------------------------------------------------
# 2. 启动对外的主 API 服务
# ------------------------------------------------------------------------------
# uvicorn: 高性能的 ASGI HTTP 服务器（常用于 FastAPI / Starlette）
# pianokt_backend.api:app: 指向模块路径，即 `pianokt_backend/api.py` 中的 FastAPI 实例 `app`
# --host 0.0.0.0: 监听所有网卡接口，允许局域网、容器外部或反向代理（如 Nginx）访问
# --port 8080: 服务运行的外部通信端口
api:
	uvicorn pianokt_backend.api:app --host 0.0.0.0 --port 8080

# ------------------------------------------------------------------------------
# 3. 启动内部工作节点/异步任务服务 (Worker API)
# ------------------------------------------------------------------------------
# 加载 `pianokt_backend/worker_api.py` 内的 `app` 实例
# --host 127.0.0.1: 仅监听本机回环地址，禁止外部网络直接访问，通常作为内部专用的任务调度/消费服务
# --port 8081: 绑定到 8081 端口，与外部 API (8080) 隔离，互不冲突
worker:
	uvicorn pianokt_backend.worker_api:app --host 127.0.0.1 --port 8081

# ------------------------------------------------------------------------------
# 4. 启动数据中继/转发进程
# ------------------------------------------------------------------------------
# pianokt-data: 项目通过 setup.py / pyproject.toml 安装到环境中的 CLI 命令行工具
# relay: 该 CLI 的子命令，通常用于接收、中继或桥接外部数据流（如 MIDI、WebSocket 或消息队列）
relay:
	pianokt-data relay

# ------------------------------------------------------------------------------
# 5. 启动数据处理流水线
# ------------------------------------------------------------------------------
# 运行 `pianokt-data` 的数据流水线子命令
# 通常负责批处理、特征提取、数据转换或模型推断流水线的常驻运行
pipeline:
	pianokt-data pipeline