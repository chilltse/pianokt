FROM python:3.13.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock pyspark==4.0.1 delta-spark==4.0.0
COPY backend/ ./
RUN pip install --no-cache-dir --no-deps . && bash fetch-jars.sh /opt/jars && useradd -m app
ENV PYSPARK_SUBMIT_ARGS="--master local[2] pyspark-shell" PIANOKT_SPARK_JARS="/opt/jars/delta-spark.jar,/opt/jars/delta-storage.jar,/opt/jars/gcs.jar"
USER app
CMD ["pianokt-data", "pipeline"]
