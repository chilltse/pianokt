DATABASE_URL=postgresql://pianokt_backend:PASSWORD@SUPABASE_SESSION_POOLER:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
FRONTEND_ORIGINS=http://localhost:5173
# Local development only. With both values below, the local API still verifies
# the Supabase JWT but skips `check_user_allowed`. Cloud Run never honours this
# bypass because its K_SERVICE environment variable is present.
PIANOKT_ENV=development
PIANOKT_LOCAL_DEV_BYPASS=1
# Only for the fully local Alignment Lab. It writes one result JSON per take;
# no GCS, Supabase database, Worker, or pipeline is used.
PIANOKT_LOCAL_ALIGNMENT_LAB=1
PIANOKT_LOCAL_ALIGNMENT_OUTPUT_DIR=../data/local-alignment
RAW_ROOT=gs://YOUR_PROJECT-pianokt-raw
LAKE_ROOT=gs://YOUR_PROJECT-pianokt-lake
CHECKPOINT_ROOT=gs://YOUR_PROJECT-pianokt-checkpoint
EVENT_TOPIC=projects/YOUR_PROJECT/topics/pianokt-events
SIGNING_SERVICE_ACCOUNT=pianokt-api@YOUR_PROJECT.iam.gserviceaccount.com
ENABLE_SPARK_EVENTS=1
