# Browser configuration for `npm run dev` only. Copy to `.env.local` and fill
# in the two public Supabase values for your development project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Use the locally running FastAPI process. Do not point this at Cloud Run if
# you expect the local allow-list bypass below to apply.
VITE_PIANOKT_API_URL=http://127.0.0.1:8000

# Only honoured by Vite's development build. Production builds always enforce
# the Supabase access list.
VITE_PIANOKT_LOCAL_BYPASS_ACCESS_LIST=true
